{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mihraf",
  "main": "./worker.js",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-binding",
      "database_id": "0841491f-e307-492d-a8ae-896ebd39e6c4"
    }
  ]
}
